# .env.example — copy to .env.local and fill in values

# NextAuth required
NEXTAUTH_URL=
AUTH_SECRET=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LinkedIn OAuth
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=

# Apple OAuth
# AUTH_APPLE_ID=
AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=
AUTH_APPLE_SECRET=



# Your backend & other envs
# BACKEND_URL=
BACKEND_URL=
Server1=
Server2=


# App / node env
NODE_ENV=
NEXT_PUBLIC_APP_URL=
# Removed (REQUIREMENTS §2 D9): the backend origin must not leak into the client
# bundle. The server gateway (src/lib/api.ts) uses the server-only BACKEND_URL.
# NEXT_PUBLIC_BACKEND_URL=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional dev helper
NEXTAUTH_DEBUG=


NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=

# NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_OPENAI_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Basic Auth gate (dev server password protection — see src/middleware.ts)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Build identifier reported to the backend as UserSession.client_version
# (X-Client-Version header). Bump per release.
NEXT_PUBLIC_APP_VERSION=
